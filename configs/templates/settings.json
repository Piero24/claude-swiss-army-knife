{
  "scan": {
    "intervalMinutes": 5,
    "excludePatterns": [
      ".venv",
      "venv",
      "__pycache__",
      ".git",
      "node_modules",
      ".next",
      ".DS_Store",
      ".pytest_cache",
      ".mypy_cache",
      "lost+found",
      ".Trash",
      "#recycle",
      "@eaDir",
      "*.app",
      "*.pkg",
      "*.bundle",
      "*.framework",
      "*.xcodeproj",
      "*.xcworkspace",
      "*.kext",
      "env",
      "site-packages",
      "lib",
      "python3.12",
      "Lib",
      "pip",
      "torch",
      "numpy",
      "_vendor",
      "dist",
      "build",
      "egg-info",
      ".egg",
      "wheel",
      "manopt",
      "eeglab2021.1",
      ".env",
      ".cache",
      ".config",
      ".npm",
      ".nvm"
    ]
  },
  "servers": {
    "ubuntu-server": {
      "enabled": true
    },
    "obsidian": {
      "enabled": true
    },
    "synology-nas": {
      "enabled": true
    },
    "github-mcp": {
      "enabled": true
    }
  },
  "auditPageSize": 50
}
