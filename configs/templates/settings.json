{
  "scan": {
    "intervalMinutes": 5,
    "excludePatterns": [
      ".venv",
      "venv",
      "__pycache__",
      ".git",
      "node_modules",
      ".next",
      ".DS_Store",
      ".pytest_cache",
      ".mypy_cache",
      "lost+found",
      ".Trash",
      "#recycle",
      "@eaDir"
    ]
  },
  "servers": {
    "ubuntu-server": {
      "enabled": true
    },
    "obsidian": {
      "enabled": true
    },
    "synology-nas": {
      "enabled": true
    },
    "github-mcp": {
      "enabled": true
    }
  },
  "auditPageSize": 50
}
